# Hugging Face Configuration
HF_TOKEN=your-huggingface-token-here
HF_REPO_ID=your-username/mafia-model

# GPU Configuration (leave empty for CPU-only)
CUDA_VISIBLE_DEVICES=0

# Training Configuration (optional, can override in docker-compose.yml)
HPARAM_TRIALS=10
HPARAM_EPOCHS=10
TRAIN_EPOCHS=100
NUM_SEEDS=5
